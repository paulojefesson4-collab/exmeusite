<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Carlos Eletricista - Profissional 24h</title>
    <style>
        body { font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; margin: 0; padding: 0; background-color: #f8f9fa; color: #333; }
        
        /* Banner de Destaque com Foto de Fundo */
        .hero { 
            background: linear-gradient(rgba(0, 0, 0, 0.6), rgba(0, 0, 0, 0.6)), url('https://unsplash.com');
            background-size: cover;
            background-position: center;
            color: white; 
            padding: 60px 20px; 
            text-align: center; 
        }
        .hero h1 { margin: 0; font-size: 2.2rem; color: #ffcc00; }
        .hero p { font-size: 1.1rem; margin: 10px 0 20px 0; }

        .container { max-width: 500px; margin: -30px auto 30px auto; background: #fff; padding: 25px; border-radius: 15px; box-shadow: 0 10px 20px rgba(0,0,0,0.1); width: 85%; }
        
        /* Botão do WhatsApp chamativo */
        .btn-whatsapp { display: block; background-color: #25d366; color: white; padding: 15px; text-decoration: none; border-radius: 10px; font-weight: bold; text-align: center; font-size: 1.1rem; box-shadow: 0 4px 10px rgba(37, 211, 102, 0.3); }
        
        /* Seção de Serviços com Fotos Menores */
        .services { margin-top: 30px; }
        .service-item { margin-bottom: 25px; background: #f1f3f5; border-radius: 10px; overflow: hidden; }
        .service-img { width: 100%; height: 150px; object-fit: cover; display: block; }
        .service-text { padding: 15px; }
        .service-text h4 { margin: 0 0 5px 0; font-size: 1.2rem; color: #222; }
        .service-text p { margin: 0; font-size: 0.95rem; color: #666; }

        footer { text-align: center; padding: 20px; font-size: 0.85rem; color: #888; }
    </style>
</head>
<body>

    <!-- Topo do site com imagem de fundo profissional -->
    <div class="hero">
        <h1>Carlos Eletricista 24h</h1>
        <p>Serviços elétricos residenciais com total segurança e rapidez</p>
    </div>

    <div class="container">
        <a href="https://wa.me" class="btn-whatsapp" target="_blank">🟢 Chamar no WhatsApp</a>
        
        <div class="services">
            <h3>Nossos Serviços:</h3>
            
            <!-- Serviço 1 com Foto -->
            <div class="service-item">
                <img class="service-img" src="https://unsplash.com" alt="Instalações">
                <div class="service-text">
                    <h4>Instalações em Geral</h4>
                    <p>Tomadas, interruptores, luminárias, painéis de LED e ventiladores de teto.</p>
                </div>
            </div>

            <!-- Serviço 2 com Foto -->
            <div class="service-item">
                <img class="service-img" src="https://unsplash.com" alt="Manutenção">
                <div class="service-text">
                    <h4>Reparos e Curtos-Circuitos</h4>
                    <p>Resolução de quedas de energia, disjuntores desarmando e fiação antiga.</p>
                </div>
            </div>
        </div>
    </div>

    <footer>
        <p>&copy; 2026 Carlos Eletricista. Natal/RN.</p>
    </footer>

</body>
</html>

